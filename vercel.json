{
  "rewrites": [
    { "source": "/ads/", "destination": "/index.html" },
    { "source": "/ads", "destination": "/index.html" },
    { "source": "/free/", "destination": "/index.html" },
    { "source": "/free", "destination": "/index.html" },
    { "source": "/cold/", "destination": "/index.html" },
    { "source": "/cold", "destination": "/index.html" },
    { "source": "/start/", "destination": "/index.html" },
    { "source": "/start", "destination": "/index.html" },
    { "source": "/go/", "destination": "/go-ads.html" },
    { "source": "/go", "destination": "/go-ads.html" },
    { "source": "/go50/", "destination": "/go-50.html" },
    { "source": "/go50", "destination": "/go-50.html" },
    { "source": "/go-v4/", "destination": "/go-v4.html" },
    { "source": "/go-v4", "destination": "/go-v4.html" },
    { "source": "/a", "destination": "/access.html" },
    { "source": "/ar", "destination": "/access.html" },
    { "source": "/access", "destination": "/access.html" },
    { "source": "/access/", "destination": "/access.html" },
    { "source": "/a/:name", "destination": "/access.html" },
    { "source": "/ar/:name", "destination": "/access.html" },
    { "source": "/access/:code", "destination": "/access.html" },

    { "source": "/s/:name", "destination": "https://winning-streak.vercel.app/api/go?p=base44&name=:name" },
    { "source": "/r/:name", "destination": "https://winning-streak.vercel.app/api/go?p=revolut&name=:name" },

    { "source": "/command-center", "destination": "https://winning-streak.vercel.app/command-center" },
    { "source": "/command-center/:path*", "destination": "https://winning-streak.vercel.app/command-center/:path*" },
    { "source": "/payments.html", "destination": "https://winning-streak.vercel.app/payments.html" },
    { "source": "/payout.html", "destination": "https://winning-streak.vercel.app/payout.html" },

    { "source": "/api/:path*", "destination": "https://winning-streak.vercel.app/api/:path*" }
  ],
  "headers": [
    {
      "source": "/(index.html|thank-you.html|thank-you-v2.html|book.html)?",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
